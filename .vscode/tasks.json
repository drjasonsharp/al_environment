{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build ASM",
      "type": "shell",
      "command": "nasm",
      "args": [
        "-f",
        "elf64",
        "-g",
        "-F",
        "dwarf",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.o"
      ]
    },
    {
      "label": "Link ASM",
      "type": "shell",
      "command": "ld",
      "args": [
        "${fileDirname}/${fileBasenameNoExtension}.o",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "dependsOn": "Build ASM"
    },
    {
      "label": "Run ASM",
      "type": "shell",
      "command": "${fileDirname}/${fileBasenameNoExtension}",
      "dependsOn": "Link ASM"
    }
  ]
}